@echo off
setlocal
REM ============================================================
REM  查看版本历史（中文说明一览）
REM   上半部分：所有版本标签 + 中文说明（最新的在最上面）
REM   下半部分：最近 20 条提交记录
REM ============================================================
set "ROOT=%~dp0.."
pushd "%ROOT%"

echo ==========================================
echo   版本标签（最新在上）
echo ==========================================
git --no-pager tag -n99 --sort=-creatordate

echo.
echo ==========================================
echo   最近 20 条提交
echo ==========================================
git --no-pager log --oneline --decorate -20

echo.
echo ------------------------------------------
echo 回到某个版本：git switch --detach v4.3
echo 回到最新版  ：git switch main
echo ------------------------------------------
popd
pause
endlocal
